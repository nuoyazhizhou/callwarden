# Call Warden daemon systemd unit（打包占位文件）
# Task: T-1784351992060-754393b5
# 设计 §8.2: pre-start 执行 schema compatibility check，迁移失败不得启动
# 安装路径: /usr/lib/systemd/system/callwarden-daemon.service
# 注意：本文件为占位，路径用绝对路径；构建时由 dpkg 安装到上述位置。
#
# 二进制：cw-daemon（Rust binary，连字符命名，对应 rust_ext/Cargo.toml [[bin]] name="cw-daemon"）
# P0-3 修复：原 cw_daemon（下划线）与 build_packages.sh 复制的 cw-daemon（连字符）不一致，
# 现已统一为 cw-daemon（Cargo [[bin]] name="cw-daemon" + build_packages.sh 复制 cw-daemon + 本 unit ExecStart cw-daemon）。
# sd_notify：Type=notify 已对接（Rust sd_notify(state) 函数，commit 5bd01a2）

[Unit]
Description=Call Warden Enterprise Daemon
Documentation=https://docs.callwarden.dev/daemon
After=network.target
Wants=network-online.target

[Service]
Type=notify
User=callwarden
Group=callwarden

# 运行时目录由 tmpfiles.d / RuntimeDirectory 创建，属主 callwarden:callwarden-clients
RuntimeDirectory=callwarden
RuntimeDirectoryMode=0755
StateDirectory=callwarden
StateDirectoryMode=0750
LogsDirectory=callwarden
LogsDirectoryMode=0750

# pre-start: schema 兼容性检查（迁移失败不得启动，exit 1）
# 子命令 schema-check（kebab-case，clap 转换）：--strict 严格版本校验
ExecStartPre=/usr/bin/cw-daemon schema-check --strict
# 默认动作 = serve（也可显式写出）；cw-daemon 不接受 --enterprise flag
#
# P0-2 降级说明（2026-07-22 复审整改-v2）：
# Rust daemon 为 CAS-only 路径——daemon_handle_refresh 完成后 CAS 数据已 publish 到
# cas_file_cache / cas_symbols / cas_raw_calls 表，但不会 merge 到主 CodeGraph DB
# 的 file_instances / symbols / calls 表（参见 rust_ext/src/daemon/replicator.rs
# daemon_handle_refresh 函数注释 + SnapshotCachePublisher::publish_snapshot 注释）。
# 即 watcher save 后通过 db_path 重载的 GraphSnapshot 仍是旧数据，无法保证 save-to-query 闭合。
#
# 企业部署若需 save-to-query 数据链闭合，请改用 Python daemon：
#   ExecStart=/usr/bin/python3 -m callwarden.server
# Python daemon 在 daemon_handle_refresh step 5 调用 merge_cas_to_codegraph + upsert_manifest，
# 把 CAS delta merge 到 CodeGraph DB 的 file_instances / symbols / calls 表。
ExecStart=/usr/bin/cw-daemon serve
ExecReload=/bin/kill -HUP $MAINPID

# 优雅停止：SIGTERM 触发 sd_notify STOPPING=1 + drain workers
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# 资源限制
LimitNOFILE=65536
TasksMax=256
MemoryHigh=2G
MemoryMax=4G

# 安全约束
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# UMask=0007 使 UDS socket 可为 callwarden-clients 组读写（0660，设计 §8.2）
UMask=0007

[Install]
WantedBy=multi-user.target
