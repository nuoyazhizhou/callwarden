# Call Warden daemon systemd unit（打包占位文件）
# Task: T-1784351992060-754393b5
# 设计 §8.2: pre-start 执行 schema compatibility check，迁移失败不得启动
# 安装路径: /usr/lib/systemd/system/callwarden-daemon.service
# 注意：本文件为占位，路径用绝对路径；构建时由 dpkg 安装到上述位置。
#
# 二进制：cw-daemon（Rust binary，连字符命名，对应 rust_ext/Cargo.toml [[bin]] name="cw-daemon"）
# P0-3 修复：原 cw_daemon（下划线）与 build_packages.sh 复制的 cw-daemon（连字符）不一致，
# 现已统一为 cw-daemon（Cargo [[bin]] name="cw-daemon" + build_packages.sh 复制 cw-daemon + 本 unit ExecStart cw-daemon）。
# sd_notify：Type=notify 已对接（Rust sd_notify(state) 函数，commit 5bd01a2）

[Unit]
Description=Call Warden Enterprise Daemon
Documentation=https://docs.callwarden.dev/daemon
After=network.target
Wants=network-online.target

[Service]
Type=notify
User=callwarden
Group=callwarden

# 运行时目录由 tmpfiles.d / RuntimeDirectory 创建，属主 callwarden:callwarden-clients
RuntimeDirectory=callwarden
RuntimeDirectoryMode=0755
StateDirectory=callwarden
StateDirectoryMode=0750
LogsDirectory=callwarden
LogsDirectoryMode=0750

# pre-start: schema 兼容性检查（迁移失败不得启动，exit 1）
# P0-4 修复（2026-07-22）：原代码使用 --strict，对未初始化的 DB（fresh install）返回 1，
# 导致 Gate 5c 的 systemctl start callwarden-daemon 在干净 runner 上失败。
# strict 模式下未初始化 DB（无 daemon_state 表或 schema_version 行）直接 exit 1，
# 但 fresh install 时 DB 尚未创建，schema-check 应允许宽松模式（自动初始化 schema）。
# 改为不带 --strict，允许 schema-check 在未初始化 DB 上通过（后续 WorkspaceRegistry::open 会初始化）。
ExecStartPre=/usr/bin/cw-daemon schema-check
# 默认动作 = serve（也可显式写出）；cw-daemon 不接受 --enterprise flag
#
# P0-2 修复（2026-07-22 完整复审）：
# Rust daemon 默认启用 save-to-query 数据链：
# - config.rs 默认 codegraph_db_path_template = /var/lib/callwarden/workspaces/{workspace_instance_id}/codegraph.db
# - daemon_handle_refresh 中 CAS → CodeGraph merge（cas_merge.rs）
# - merge 成功后才 file_generation_committed（P0-1 修复）
# - replicate 发布 snapshot（GraphStore 加载 CodeGraph DB）
# daemon 首次访问 CodeGraph DB 时自动创建目录（workspace.rs create_dir_all）
ExecStart=/usr/bin/cw-daemon serve
ExecReload=/bin/kill -HUP $MAINPID

# 优雅停止：SIGTERM 触发 sd_notify STOPPING=1 + drain workers
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# 资源限制
LimitNOFILE=65536
TasksMax=256
MemoryHigh=2G
MemoryMax=4G

# 安全约束
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# UMask=0007 使 UDS socket 可为 callwarden-clients 组读写（0660，设计 §8.2）
UMask=0007

[Install]
WantedBy=multi-user.target
