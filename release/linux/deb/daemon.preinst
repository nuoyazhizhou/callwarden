#!/bin/bash
# callwarden-daemon preinst
# Task: T-1783983162956-b2a8
# 设计 §8.3 升级顺序（前置部分）: 版本/空间预检 → drain → 在线备份 → 停服务
# 失败时中止升级，不进入 dpkg 解包阶段，避免"新 schema + 旧二进制"组合。

set -euo pipefail

# 运行时常量
DAEMON_USER="callwarden"
STATE_DIR="/var/lib/callwarden"
LOG_DIR="/var/log/callwarden"
BACKUP_DIR="/var/lib/callwarden/backup"
SOCKET="/run/callwarden/callwarden.sock"
SERVICE="callwarden-daemon.service"
# 在线备份保留份数
BACKUP_KEEP=3

case "$1" in
    install)
        # 首次安装：无需备份/停服务
        echo "[callwarden-daemon] preinst: first install"
        ;;
    upgrade)
        OLD_VERSION="${2:-unknown}"
        echo "[callwarden-daemon] preinst: upgrade from $OLD_VERSION"

        # 1. 版本/兼容性预检（N-1 兼容性）
        # 检查当前 schema 版本与即将安装的二进制 ABI 是否兼容
        # P0-3 整改（2026-07-22）：cw-daemon 只支持 schema-check --strict
        # （不支持 --pre-upgrade，也不支持 drain/snapshot create/migrate 子命令）
        if [ -x /usr/bin/cw-daemon ]; then
            if ! /usr/bin/cw-daemon schema-check --strict; then
                echo "[callwarden-daemon] ERROR: schema compatibility pre-check failed" >&2
                echo "[callwarden-daemon] Aborting upgrade to avoid new-schema + old-binary state." >&2
                exit 1
            fi
        fi

        # 2. 磁盘空间预检（至少 2x state 目录大小，用于备份与迁移）
        if [ -d "$STATE_DIR" ]; then
            DB_SIZE="$(du -sb "$STATE_DIR" 2>/dev/null | awk '{print $1}')"
            AVAIL="$(df -B1 "$STATE_DIR" | awk 'NR==2{print $4}')"
            if [ -n "${DB_SIZE:-}" ] && [ -n "${AVAIL:-}" ] && [ "${DB_SIZE:-0}" -gt 0 ]; then
                NEEDED=$((DB_SIZE * 2))
                if [ "$AVAIL" -lt "$NEEDED" ]; then
                    echo "[callwarden-daemon] ERROR: insufficient disk space (need ${NEEDED}B, have ${AVAIL}B)" >&2
                    exit 1
                fi
            fi
        fi

        # 3. Drain：cw-daemon 不支持 drain 子命令
        # P0-3 整改（2026-07-22）：移除 cw-daemon drain 调用，
        # systemctl stop 会发 SIGTERM，daemon 自己处理 graceful shutdown（KillMode=mixed）

        # 4. 在线备份（停服务前的最后一致点）
        # P0-3 整改（2026-07-22）：cw-daemon 不支持 snapshot create 子命令，
        # 改用 tar 直接备份 state 目录（SQLite WAL 会被 tar 包含）
        if [ -d "$STATE_DIR" ]; then
            mkdir -p "$BACKUP_DIR"
            TS="$(date +%Y%m%d-%H%M%S)"
            BACKUP_TAG="pre-upgrade-${OLD_VERSION}-${TS}"
            echo "[callwarden-daemon] creating online backup: $BACKUP_TAG"
            tar -cf "$BACKUP_DIR/$BACKUP_TAG.tar" -C "$STATE_DIR" . 2>/dev/null || true
            # 清理过期备份，仅保留最近 BACKUP_KEEP 份
            ls -1dt "$BACKUP_DIR"/pre-upgrade-* 2>/dev/null | tail -n +$((BACKUP_KEEP + 1)) | while read -r old; do
                rm -rf "$old"
            done
        fi

        # 5. 停止服务（dpkg 解包前，确保旧二进制不再运行）
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop "$SERVICE" 2>/dev/null || true
        fi
        ;;
    abort-upgrade)
        echo "[callwarden-daemon] preinst: abort-upgrade"
        ;;
    *)
        echo "[callwarden-daemon] preinst: unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
