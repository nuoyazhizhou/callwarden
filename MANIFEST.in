# MANIFEST.in —— P0-3 修复（问题 2）：确保 sdist/wheel 包含预编译的 Rust 扩展二进制
#
# 复审报告 §3 P0-3 问题 2 指出：
#   - setup.py 已声明 BinaryDistribution.has_ext_modules()=True，
#     wheel 会包含根目录的 callwarden_core.pyd/.so
#   - 但 sdist 不会自动包含这些二进制（setuptools 默认只打包 .py）
#   - 干净 runner 上 `python -m build` 默认同时产出 wheel + sdist，
#     若 sdist 缺失二进制会导致从 sdist 重构建 wheel 时失败
#
# 修复策略：显式声明 include 这些二进制文件
#   - callwarden_core.pyd（Windows）
#   - callwarden_core.so（Linux / macOS）
#
# 注意：wheel 包含由 setup.py BinaryDistribution 处理（has_ext_modules=True），
#       MANIFEST.in 主要补全 sdist 的内容声明。

# Rust 扩展预编译二进制（核心：必须随包发布，否则 cw 退化为纯 Python 无加速）
include callwarden_core.pyd
include callwarden_core.so

# 版本源与构建脚本
include release/version.toml
include release/version_sync.py
include release/build.py
include pyproject.toml
include setup.py
include README.md
include LICENSE

# 安装器资源（Windows WiX / macOS pkg / Linux deb）
# 只包含源码/配置，排除构建产物（.msi/.pkg/.deb/.wixobj 等）
recursive-include release/windows *.wxs
recursive-include release/macos *.sh
recursive-include release/linux *.sh *.service *.conf *.postinst *.postrm *.preinst *.preinst
recursive-include release/linux/deb *

# Rust 扩展源码（cargo build 需要）
recursive-include rust_ext *.rs
recursive-include rust_ext Cargo.toml
recursive-include rust_ext Cargo.lock

# 多语言解析器配置
include config.py
include cw.py

# 所有包目录的 Python 源文件（确保 sdist 完整，wheel 从 sdist 构建时不会缺文件）
recursive-include analyzers *.py
recursive-include cicd *.py
recursive-include cli *.py
recursive-include db *.py
recursive-include parsers *.py
recursive-include server *.py

# 测试套件（用于 Gate 1 源码测试）
recursive-include tests *.py

# 国际化资源（包含 __init__.py 包入口 + JSON 翻译文件）
include i18n/__init__.py
recursive-include i18n *.json

# 忽略构建产物与缓存
exclude .gitignore
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd.bak
global-exclude .pytest_cache
