# ==========================================
# Call Warden .gitignore
# ==========================================

# ------------------------------------------
# 不入库的文档（内部分析报告等）
# ------------------------------------------
callwarden_USER_GUIDE.md
callwarden 功能差距分析报告.md
callwarden 与 200 个仓库的交叉对比分析.md
docs/history/
prompts/

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl

# 虚拟环境
venv/
.venv/
env/
.env
.env/

# Node.js / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 测试缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ------------------------------------------
# SQLite 数据库（Call Warden 生成的数据库不入库）
# ------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.callwarden.db

# ------------------------------------------
# tree-sitter 编译缓存
# ------------------------------------------
tree-sitter-*.so
*.so

# ------------------------------------------
# Rust 扩展编译产物（PyO3）
# ------------------------------------------
rust_ext/target/
rust_ext/**/*.so
target/

# ------------------------------------------
# IDE 与编辑器
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ------------------------------------------
# AI 辅助工具元数据（不入仓库）
# ------------------------------------------
.trae/
.claude/
.cursor/
.codex/
.gemini/
.kiro/
.opencode/
.qoder/
.agent/

# ------------------------------------------
# 输出与日志
# ------------------------------------------
*.log
*.out
tests/_probe_output.txt

# ------------------------------------------
# 本地配置（用户私有）
# ------------------------------------------
.callwardenignore
.codegraphinclude

# ------------------------------------------
# 临时文件
# ------------------------------------------
tmp/
temp/
*.tmp
